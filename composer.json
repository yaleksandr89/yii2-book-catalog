{
    "name": "yaleksandr89/yii2-book-catalog",
    "description": "Yii2 web book catalog with authors, subscriptions, Top-10 report, image uploads, and SMSPilot test notifications.",
    "homepage": "https://github.com/yaleksandr89/yii2-book-catalog",
    "keywords": [
        "yii2",
        "book-catalog",
        "mysql",
        "docker"
    ],
    "authors": [
        {
            "name": "Александр Юрченко",
            "email": "y.aleksandr89@yandex.ru",
            "homepage": "https://github.com/yaleksandr89",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/yaleksandr89/yii2-book-catalog/issues",
        "source": "https://github.com/yaleksandr89/yii2-book-catalog",
        "forum": "https://github.com/yaleksandr89/yii2-book-catalog/discussions",
        "security": "https://github.com/yaleksandr89/yii2-book-catalog/security/policy"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://boosty.to/backendbezpafosa"
        },
        {
            "type": "other",
            "url": "https://sponsr.ru/backendbezpafosa/"
        }
    ],
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "require": {
        "php": "~8.5.0",
        "yiisoft/yii2": "~2.0.55",
        "yiisoft/yii2-bootstrap5": "~2.0.2",
        "yiisoft/yii2-httpclient": "^2.0.17"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "~3.95.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^13.0",
        "yiisoft/yii2-debug": "~2.1.0",
        "yiisoft/yii2-faker": "~2.0.0",
        "yiisoft/yii2-gii": "~2.2.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "find assets commands config controllers integrations migrations models services tests views widgets -type f -name '*.php' -exec php -l {} + && php -l .php-cs-fixer.dist.php web/index.php yii",
        "test": "phpunit --configuration=phpunit.xml.dist",
        "analyse": "phpstan analyse --configuration=phpstan.neon.dist --no-progress --memory-limit=-1",
        "cs:check": "php-cs-fixer check --config=.php-cs-fixer.dist.php --diff",
        "cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "check": [
            "@composer validate --strict --no-check-publish",
            "@composer audit --locked",
            "@lint",
            "@cs:check",
            "@analyse",
            "@test"
        ],
        "post-install-cmd": [
            "yii\\composer\\Installer::postInstall"
        ],
        "post-create-project-cmd": [
            "yii\\composer\\Installer::postCreateProject",
            "yii\\composer\\Installer::postInstall"
        ]
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        },
        "process-timeout": 1800,
        "sort-packages": true,
        "fxp-asset": {
            "enabled": false
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ]
}
