<?xml version="1.0"?>
<ruleset name="Yii2 Book Catalog">
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <rule ref="vendor/yiisoft/yii2-coding-standards/Yii2/ruleset.xml"/>
    <exclude-pattern>config/__autocomplete.php</exclude-pattern>
    <exclude-pattern>tests/bootstrap.php</exclude-pattern>
    <file>assets</file>
    <file>commands</file>
    <file>config</file>
    <file>controllers</file>
    <file>models</file>
    <file>tests</file>
    <file>widgets</file>
</ruleset>
